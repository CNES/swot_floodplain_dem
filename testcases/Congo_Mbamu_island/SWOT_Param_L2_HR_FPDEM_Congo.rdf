# Lat/lon extrema of the Area Of Interest
latitude min = -4.6
latitude max = -3.88
longitude min = 15.0
longitude max = 15.6

#
# PIXC / PIXCVec input info
#
# Path to PIXC list
PIXC file list = /work/SWOT/swotdev/swotdev/lemrabl/floodplaindem/testcases/Congo_Mbamu_island/input/pixc/SWOT_L2_HR_PIXC_*.nc

# Path to PIXCVec list
PIXCVec file list = /work/SWOT/swotdev/swotdev/lemrabl/floodplaindem/testcases/Congo_Mbamu_island/input/pixcvec/SWOT_L2_HR_PIXCVec_*.nc


#
# Output info
#
# Output directory
output directory = /work/SWOT/swotdev/swotdev/lemrabl/floodplaindem/testcases/Congo_Mbamu_island/output

# Output filename extensions
tile name = 04S15E
first date name = 20231122T213924
last date name = 20250427T122623


# Select model approach : 
# Bathtub ring method or a mix of bathtub and clustering and direct extraction of land
select_approach = mixed # mixed or bathtub


# Pekel info : 
# Path and name of the Pekel occurrences file
Pekel path = /work/datalake/static_aux/MASQUES/PEKEL/data2021/occurrence/occurrence.vrt


# SWORD info : 
# Path to SWORD database
Sword path = /work/SWOT/swotdev/swotpub/BD/BD_rivers/SWORD_v17/shp
# Paths and names of hydrobasins (level1 and level2) files
hydrobasin nv1 file = /work/SWOT/swotdev/swotpub/BD/major_basins/HydroBASINS/level1/hybas_lev01_v1c.shp
hydrobasin nv2 file = /work/SWOT/swotdev/swotpub/BD/major_basins/HydroBASINS/level2/hybas_lev02_v1c.shp

# Swot science orbits and tiles path and filename
swot tiles file = /work/SWOT/swotdev/swotdev/stephag/orbits/swot_science_hr_2.0s_4.0s_June2019-v3_swath_tile.shp


#
# Mask
#
# To filter points around a specific lake, river, 
# or filter only points present in Pekel occurrences (1->100%; with a buffer if mask_buffer_size != 0)
# 0 : no; 1 : yes (with PLD); 2 : yes (with Pekel); 3 : yes (with Sword)
use mask = 0
# Buffer in soil geometry (degrees)
mask buffer size = 0.02 # Optional parameter : only required if use mask >= 1
# PLD info
lake id = 0 # Optional parameter : only required if use mask = 1
PLD path = /work/SWOT/swotdev/swotpub/BD/BD_lakes/PLD/Nom/ # Optional parameter : only required if use mask = 1


# Threading option: choose "multiprocessing" if parallel run is wanted
threading option = multiprocessing
# Define the number of core processing units (Optional: if 'multiprocessing is chosen')
number of cpu = 12


# Plot
plot = yes1 # Options: no, yes1 (only for Python script), yes2 (for notebook)


#
# PIXC pre-processing
#
# Range value of the crosstrack minimum value wanted
cross track min value = 10000.
# Minimum surface of a water body kept for FPDEM method
area threshold = 100000.


#
# Clustering method params : performed on WATER_LAND labels (optional if select_approach=bathtub)
#
clustering outlier filter method = isolation_forest # zscore or isolation_forest
clustering method = kmeans # kmeans, birch, hdbscan_tsne or hdbscan_umap are possible choices
# Once the clustering is performed, all water bodies will get their contour extracted;
# Choose either the bathtub ring method (like it is already done for WATER labels) 
# or the geopandas concave hull method (might be better for small water bodies)
clustering water contour = concavehull # bathtub or concavehull


#
# Filtering
#

# Pekel filtering :
# At the beginning of the bathy extraction,
# Filtering Dark water, all PIXC points within Pekel occurrences > {chosen value}% are kept
pekel percent for Dark Water = 95
# At the end of the bathy extraction,
# Filter out all points within Pekel occurrences > {chosen value}% 
pekel filtering end = yes # yes or no
pekel filtering value = 99 # Threshold occurrence value

# Quality flags for filtering :
# At the beginning of the bathy extraction, 
# Filter sig0_qual: 'no' = do not filter; 'yes' = keep only good points (i.e., sig0_qual=0)
sig0_qual = yes # yes or no
# At the end of the bathy extraction,
# Select the bit threshold for each quality flag, all FPDEM/PIXC points with a bit higher than the chosen value are filtered out
classification_qual = 33554432
geolocation_qual = 33554432

# Isolated points filtering :
# Maximum distance in degrees for two points to be considered neighbors
distance to neighbors = 0.001
# All points with less meighbors than the chosen value are filtered out
number of neighbors = 5

# Labeling water bodies :
# Remove objects smaller than or equal to chosen size
water body min size = 1000
# Connectivity defining the neighborhood of a pixel
connectivity = 1


#
# Extract area / Obtain polygon for rasterisation
#
concave hull ratio = 0.005


#
# Raster
#
# Choose between 'latlon' or 'utm' for the definition of the raster grid
mode = latlon
# The resolution is in degrees for latlon mode and meters for utm mode
resolution = 0.000277777
